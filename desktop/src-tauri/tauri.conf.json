{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMretro",
  "version": "0.3.1",
  "identifier": "com.retrohub.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AMretro",
        "width": 1280,
        "height": 800,
        "minWidth": 840,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https: http: data: blob:; connect-src ipc: http://ipc.localhost https: http:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
