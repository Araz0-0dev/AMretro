+# arm.c embeds ARM-mode instructions as data. Calling them from a Thumb-2
+# co_switch can be optimized into a Thumb branch, corrupting the CPU state.
+# Compile this small library in ARM mode on Android ARMv7; the linker handles
+# calls to/from Thumb code and entrypoints.
+if(ANDROID AND ANDROID_ABI STREQUAL "armeabi-v7a")
+  target_compile_options(libco PRIVATE -marm)
+endif()
+
